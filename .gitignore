# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
*.so
.venv/
venv/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Data files (large — track only metadata and README)
workspace/data/**/*.h5ad
workspace/data/**/*.loom
workspace/data/**/*.h5
workspace/data/**/*.zarr
workspace/cache/
workspace/models/*/checkpoints/
workspace/models/**/*.bin
workspace/models/**/*.pt
workspace/models/**/*.safetensors

# Experiment results (keep scripts, not raw outputs)
experiments/results/
experiments/.plans/*.lock
experiments/analyses/__pycache__/

# Session notes (auto-generated, not source)
notes/

# Research outputs (audits, reports — keep manually promoted ones only)
workspace/research/

# Node / Pi runtime
node_modules/
.feynman/agent/
dist/

# Build artifacts
*.d.mts
*.mjs

# OS
.DS_Store
Thumbs.db

# Environment
.env
*.local

# Large model weights
*.bin
*.pt
*.pth
*.ckpt
*.safetensors

# Logs
*.log

# Large h5ad source files (358MB each, not tracked in git)
workspace/data/raw_h5ad/replogle_k562_gwps/

# API response caches (regenerated on demand, not source)
workspace/evaluation/_archs4_cache/
workspace/evaluation/_kegg_cache/
workspace/evaluation/_ppi_cache/
workspace/evaluation/_reactome_cache/
workspace/evaluation/_reveal_ppi_cache/
workspace/data/_universal_cache/
workspace/data/depmap/

# Interactive experiment campaign traces (user/run artifacts, not repo data)
workspace/results/campaigns/

# Phenotypes the scientist registers from their own screens (user data, not repo data)
workspace/data/user_phenotypes/

# CRISPRa validation table (derived from an external download; rebuild with build_crispra_validation.py)
workspace/evaluation/lgbm_training_data_crispra_validation.csv
# CRISPRa validation run outputs — regenerable from the (gitignored) table above; not committed
workspace/results/sequential/crispra_*.json
*.aux

# LaTeX / hyperref bookmark aux (regenerated on compile)
*.out

# Stale experiment locks left under results (never source)
workspace/results/**/*.lock

# Figures live in workspace/results/figures/ (paper loads them via graphicspath); keep docs/ free of figure copies
docs/*.png

# Session retrospective / PPT plan — working note, not committed
docs/RETROSPECTIVE_AND_PPT_PLAN.md

# BDA difficulty-tier tables. The two full-pool tables are committed alongside v1/v2/v3 because, like
# them, they cannot be rebuilt from a fresh clone (the STRING PPI / KEGG / Reactome caches are
# ignored). The two combinatorial tables are NOT: build_horlbeck_pairs.py regenerates them in seconds,
# deterministically and offline, from inputs that are committed -- the full-pool tables plus BDA's own
# ground_truth_Horlbeck.csv / topmovers_Horlbeck.npy -- so 72 MB of derived rows buys nothing.
workspace/evaluation/lgbm_training_data_horlbeck_pairs.csv
workspace/evaluation/lgbm_training_data_horlbeck_pairs_v3.csv

# Run logs under results/ are console transcripts, not results (matching the existing 20-rep dirs,
# which track only .json). The provenance that matters lives in the .manifest.json sidecars.
workspace/results/**/*.log
workspace/results/**/*.tmp
