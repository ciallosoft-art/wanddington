# Experiment results (keep scripts, not raw outputs)
experiments/results/
experiments/.plans/*.lock
experiments/analyses/__pycache__/

# Session notes (auto-generated, not source)
notes/

# Research outputs (audits, reports — keep manually promoted ones only)
workspace/research/

# Node / Pi runtime
node_modules/
.feynman/agent/
dist/

